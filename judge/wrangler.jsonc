{
  // Executor de código Python. Sem rota pública: só a API o chama (service binding).
  "name": "coderank-judge",
  "main": "entry.py",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["python_workers", "disable_python_external_sdk"],
  "workers_dev": false,
  "preview_urls": false
  // Plano pago: adicione "vars": { "TRACE": "1" } para ligar o limite de 2 s por teste.
}
